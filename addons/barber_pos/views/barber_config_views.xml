<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════
         VUES : Configuration du Salon
    ════════════════════════════════════════════════════ -->

    <!-- Formulaire Config -->
    <record id="view_barber_config_form" model="ir.ui.view">
        <field name="name">barber.config.form</field>
        <field name="model">barber.config</field>
        <field name="arch" type="xml">
            <form string="Configuration du Salon">
                <sheet>
                    <div class="oe_title">
                        <label for="salon_name" class="oe_edit_only"/>
                        <h1>
                            <field name="salon_name" placeholder="Nom du salon..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="💈 Informations du Salon">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                        </group>
                        <group string="🧾 Paramètres Caisse">
                            <field name="tax_rate"/>
                            <field name="opening_time" widget="float_time"/>
                            <field name="closing_time" widget="float_time"/>
                        </group>
                    </group>
                    <group string="📄 Ticket de Caisse">
                        <field name="receipt_header" placeholder="Texte d'en-tête du ticket..."/>
                        <field name="receipt_footer" placeholder="Texte de pied de ticket..."/>
                    </group>
                    <group string="🖼️ Logo">
                        <field name="logo" widget="image" options="{'size': [256, 256]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Config -->
    <record id="action_barber_config" model="ir.actions.act_window">
        <field name="name">⚙️ Configuration Salon</field>
        <field name="res_model">barber.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
