<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════
         VUES : Contrats Coiffeurs
    ════════════════════════════════════════════════════ -->

    <record id="view_barber_contract_list" model="ir.ui.view">
        <field name="name">barber.contract.list</field>
        <field name="model">barber.contract</field>
        <field name="arch" type="xml">
            <list string="Contrats" decoration-danger="is_expired"
                  decoration-muted="state in ('expired', 'cancelled')">
                <field name="barber_id"/>
                <field name="contract_type"/>
                <field name="monthly_rent" optional="show"/>
                <field name="percentage" optional="show"/>
                <field name="percentage_base" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state in ('expired', 'cancelled')"/>
                <field name="is_expired" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_barber_contract_form" model="ir.ui.view">
        <field name="name">barber.contract.form</field>
        <field name="model">barber.contract</field>
        <field name="arch" type="xml">
            <form string="Contrat Coiffeur">
                <header>
                    <button name="action_activate" type="object" string="✅ Activer"
                            class="btn-success"
                            invisible="state == 'active'"/>
                    <button name="action_expire" type="object" string="Clôturer"
                            class="btn-warning"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="❌ Annuler"
                            class="btn-danger"
                            invisible="state in ('expired', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="♻️ Remettre en brouillon"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_expired">
                        ⚠️ Ce contrat est expiré. Veuillez le renouveler ou créer un nouveau contrat.
                    </div>
                    <group>
                        <group string="👤 Coiffeur">
                            <field name="barber_id"/>
                        </group>
                        <group string="📋 Type de contrat">
                            <field name="contract_type" widget="radio"/>
                        </group>
                    </group>
                    <group invisible="contract_type != 'rent'" string="🏠 Location Mensuelle">
                        <group>
                            <field name="monthly_rent"/>
                            <field name="rent_due_day"/>
                        </group>
                    </group>
                    <group invisible="contract_type != 'percentage'" string="📊 Pourcentage du CA">
                        <group>
                            <field name="percentage"/>
                            <field name="percentage_base"/>
                        </group>
                    </group>
                    <group string="📅 Période">
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="📝 Conditions">
                        <field name="notes" nolabel="1"
                               placeholder="Conditions particulières du contrat, clauses spéciales..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_barber_contract_search" model="ir.ui.view">
        <field name="name">barber.contract.search</field>
        <field name="model">barber.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="barber_id"/>
            </search>
        </field>
    </record>

    <record id="action_barber_contract" model="ir.actions.act_window">
        <field name="name">📋 Contrats</field>
        <field name="res_model">barber.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_barber_contract_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun contrat enregistré
            </p>
            <p>Créez des contrats pour vos coiffeurs : loyer mensuel ou pourcentage du CA.</p>
        </field>
    </record>
</odoo>
