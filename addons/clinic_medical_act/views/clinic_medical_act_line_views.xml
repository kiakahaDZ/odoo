<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue Formulaire Ligne Acte Médical -->
        <record id="view_clinic_medical_act_line_form" model="ir.ui.view">
            <field name="name">clinic.medical.act.line.form</field>
            <field name="model">clinic.medical.act.line</field>
            <field name="arch" type="xml">
                <form string="Acte Médical">
                    <header>
                        <button name="action_set_paid" string="Marquer Payé" type="object" class="btn-primary" invisible="state != 'waiting'"/>
                        <button name="action_set_in_progress" string="En Cours" type="object" class="btn-primary" invisible="state != 'paid'"/>
                        <button name="action_validate" string="Valider" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                        <button name="action_cancel" string="Annuler" type="object" class="btn-secondary" invisible="state in ['done', 'cancelled']"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,waiting,paid,in_progress,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="patient_id" readonly="state != 'draft'"/>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="product_id" readonly="state != 'draft'"/>
                                <field name="medical_act_type" readonly="1"/>
                                <field name="requires_validation" invisible="1"/>
                                <field name="service_type" readonly="1"/>
                            </group>
                            <group>
                                <field name="doctor_id" readonly="state != 'draft'"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="price_unit" widget="monetary" readonly="state != 'draft'"/>
                                <field name="quantity" readonly="state != 'draft'"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="price_total"/>
                                </div>
                                <field name="price_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="payment_date" readonly="1"/>
                                <field name="validated_by" readonly="1"/>
                                <field name="validation_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="doctor_share_amount" widget="monetary" readonly="1"/>
                                <field name="clinic_share_amount" widget="monetary" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes" placeholder="Notes ou observations..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vue Liste Acte Médical -->
        <record id="view_clinic_medical_act_line_list" model="ir.ui.view">
            <field name="name">clinic.medical.act.line.list</field>
            <field name="model">clinic.medical.act.line</field>
            <field name="arch" type="xml">
                <list string="Actes Médicaux" decoration-info="state == 'waiting'" decoration-success="state == 'done'" decoration-warning="state == 'draft'" decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="patient_id"/>
                    <field name="product_id"/>
                    <field name="medical_act_type" optional="show"/>
                    <field name="doctor_id" optional="show"/>
                    <field name="price_total" sum="Total"/>
                    <field name="state" widget="badge" decoration-info="state == 'waiting'" decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <!-- Vue Kanban Acte Médical -->
        <record id="view_clinic_medical_act_line_kanban" model="ir.ui.view">
            <field name="name">clinic.medical.act.line.kanban</field>
            <field name="model">clinic.medical.act.line</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="medical_act_type"/>
                    <field name="price_total"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                    <span class="badge badge-pill"><field name="state" widget="label_selection"/></span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <p><strong>Patient:</strong> <field name="patient_id"/></p>
                                    <p><strong>Type:</strong> <field name="medical_act_type"/></p>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="price_total" widget="monetary"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vue Recherche -->
        <record id="view_clinic_medical_act_line_search" model="ir.ui.view">
            <field name="name">clinic.medical.act.line.search</field>
            <field name="model">clinic.medical.act.line</field>
            <field name="arch" type="xml">
                <search string="Rechercher Actes">
                    <field name="patient_id"/>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="doctor_id"/>
                    <separator/>
                    <filter string="En Attente" name="waiting" domain="[('state','=','waiting')]"/>
                    <filter string="Payés" name="paid" domain="[('state','=','paid')]"/>
                    <filter string="Terminés" name="done" domain="[('state','=','done')]"/>
                    <separator/>
                    <filter string="Laboratoire" name="laboratory" domain="[('medical_act_type','=','laboratory')]"/>
                    <filter string="Imagerie" name="imaging" domain="[('medical_act_type','=','imaging')]"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_clinic_medical_act_lines" model="ir.actions.act_window">
            <field name="name">Actes Médicaux</field>
            <field name="res_model">clinic.medical.act.line</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_clinic_medical_act_line_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouvel acte médical
                </p>
                <p>
                    Enregistrez les actes médicaux effectués pour les patients.
                </p>
            </field>
        </record>
    </data>
</odoo>
