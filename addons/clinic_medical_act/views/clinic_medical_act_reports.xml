<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue Kanban Actes Médicaux -->
        <record id="view_clinic_medical_act_line_kanban" model="ir.ui.view">
            <field name="name">clinic.medical.act.line.kanban</field>
            <field name="model">clinic.medical.act.line</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" records_per_column="5">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="product_id"/>
                    <field name="price_total"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_card_header">
                                    <strong><field name="patient_id"/></strong>
                                </div>
                                <div class="oe_kanban_card_content">
                                    <field name="product_id"/>
                                    <div class="oe_kanban_footer_right">
                                        <span class="badge badge-success">
                                            <field name="price_total" widget="monetary"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vue Graphique - Actes par Type -->
        <record id="view_clinic_medical_act_line_graph_type" model="ir.ui.view">
            <field name="name">clinic.medical.act.line.graph.type</field>
            <field name="model">clinic.medical.act.line</field>
            <field name="arch" type="xml">
                <graph string="Actes par Type" type="bar">
                    <field name="medical_act_type" type="row"/>
                    <field name="price_total" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Vue Graphique - Actes par État -->
        <record id="view_clinic_medical_act_line_graph_state" model="ir.ui.view">
            <field name="name">clinic.medical.act.line.graph.state</field>
            <field name="model">clinic.medical.act.line</field>
            <field name="arch" type="xml">
                <graph string="Actes par État" type="pie">
                    <field name="state" type="row"/>
                    <field name="price_total" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Vue Pivot - Analyse Détaillée -->
        <record id="view_clinic_medical_act_line_pivot" model="ir.ui.view">
            <field name="name">clinic.medical.act.line.pivot</field>
            <field name="model">clinic.medical.act.line</field>
            <field name="arch" type="xml">
                <pivot string="Analyse Actes Médicaux">
                    <field name="medical_act_type" type="row"/>
                    <field name="state" type="col"/>
                    <field name="price_total" type="measure" aggregation="sum"/>
                </pivot>
            </field>
        </record>

        <!-- Mise à jour de l'action pour inclure les nouvelles vues -->
        <record id="action_clinic_medical_act_lines" model="ir.actions.act_window">
            <field name="name">Tous les Actes</field>
            <field name="res_model">clinic.medical.act.line</field>
            <field name="view_mode">kanban,list,form,graph,pivot</field>
            <field name="search_view_id" ref="view_clinic_medical_act_line_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucun acte médical enregistré
                </p>
                <p>
                    Les actes médicaux payés par les patients apparaîtront ici pour suivi et validation.
                </p>
            </field>
        </record>
    </data>
</odoo>
