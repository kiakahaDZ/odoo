<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 1. Catégorie de Module -->
        <record id="module_category_healthcare" model="ir.module.category">
            <field name="name">Gestion Clinique</field>
            <field name="description">Gestion des patients et actes médicaux</field>
            <field name="sequence">10</field>
        </record>

        <!-- 2. Privilège (Nouveau concept Odoo 19/Master) -->
        <record id="privilege_clinic_role" model="res.groups.privilege">
            <field name="name">Rôle</field>
            <field name="category_id" ref="module_category_healthcare"/>
        </record>

        <!-- 3. Groupes liés au Privilège -->
        <record id="group_clinic_receptionist" model="res.groups">
            <field name="name">Réceptionniste</field>
            <field name="privilege_id" ref="privilege_clinic_role"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">1</field>
        </record>

        <record id="group_clinic_cashier" model="res.groups">
            <field name="name">Caissier</field>
            <field name="privilege_id" ref="privilege_clinic_role"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">2</field>
        </record>

        <record id="group_clinic_lab_tech" model="res.groups">
            <field name="name">Technicien Laboratoire</field>
            <field name="privilege_id" ref="privilege_clinic_role"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">3</field>
        </record>

        <record id="group_clinic_imaging_tech" model="res.groups">
            <field name="name">Technicien Imagerie</field>
            <field name="privilege_id" ref="privilege_clinic_role"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">4</field>
        </record>

        <record id="group_clinic_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="privilege_id" ref="privilege_clinic_role"/>
            <field name="implied_ids" eval="[(4, ref('group_clinic_receptionist')), (4, ref('group_clinic_cashier')), (4, ref('group_clinic_lab_tech')), (4, ref('group_clinic_imaging_tech'))]"/>
            <field name="sequence">10</field>
        </record>

        <!-- Règles d'accès SIMPLIFIÉES - Admin toujours autorisé -->
        
        <!-- Règle Admin : Accès complet à tous les partenaires -->
        <record id="clinic_patient_rule_admin" model="ir.rule">
            <field name="name">Accès Admin - Tous les partenaires</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Règle unique : Les employés cliniques voient seulement les patients -->
        <record id="clinic_patient_rule_all" model="ir.rule">
            <field name="name">Accès Patients - Employés</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('is_patient','=',True)]</field>
            <field name="groups" eval="[(4, ref('group_clinic_receptionist')), (4, ref('group_clinic_cashier')), (4, ref('group_clinic_lab_tech')), (4, ref('group_clinic_imaging_tech')), (4, ref('group_clinic_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
