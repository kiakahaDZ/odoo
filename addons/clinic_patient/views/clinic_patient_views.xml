<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue Formulaire Patient -->
        <record id="view_clinic_patient_form" model="ir.ui.view">
            <field name="name">clinic.patient.form</field>
            <field name="model">res.partner</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <form string="Fiche Patient">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nom du Patient" required="1"/>
                            </h1>
                            <h2>
                                <field name="patient_number" readonly="1"/>
                            </h2>
                        </div>
                        
                        <group>
                            <group string="Informations Personnelles">
                                <field name="is_patient" invisible="1"/>
                                <field name="date_of_birth" required="1"/>
                                <field name="age" readonly="1"/>
                                <field name="gender" required="1"/>
                                <field name="blood_group"/>
                                <field name="patient_status"/>
                            </group>
                            
                            <group string="Contact">
                                <field name="phone" required="1"/>
                                <field name="email"/>
                                <field name="street" placeholder="Adresse"/>
                                <field name="city"/>
                                <field name="country_id"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Contact d'Urgence">
                                <field name="emergency_contact"/>
                                <field name="emergency_phone"/>
                            </group>
                            
                            <group string="Assurance">
                                <field name="insurance_company"/>
                                <field name="insurance_number"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Informations Médicales">
                                <group>
                                    <field name="allergies" placeholder="Liste des allergies connues..."/>
                                    <field name="chronic_diseases" placeholder="Maladies chroniques..."/>
                                    <field name="medical_notes" placeholder="Notes médicales importantes..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vue Liste Patient -->
        <record id="view_clinic_patient_list" model="ir.ui.view">
            <field name="name">clinic.patient.list</field>
            <field name="model">res.partner</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <list string="Liste des Patients">
                    <field name="patient_number"/>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="gender"/>
                    <field name="phone"/>
                    <field name="patient_status"/>
                </list>
            </field>
        </record>

        <!-- Vue Kanban Patient -->
        <record id="view_clinic_patient_kanban" model="ir.ui.view">
            <field name="name">clinic.patient.kanban</field>
            <field name="model">res.partner</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="patient_number"/>
                    <field name="age"/>
                    <field name="gender"/>
                    <field name="phone"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('res.partner', 'image_128', record.id.raw_value)" alt="Patient"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="patient_number"/>
                                    </div>
                                    <ul>
                                        <li><i class="fa fa-birthday-cake" title="Âge"/> <field name="age"/> ans</li>
                                        <li><i class="fa fa-phone" title="Téléphone"/> <field name="phone"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vue Recherche Patient Avancée -->
        <record id="view_clinic_patient_search" model="ir.ui.view">
            <field name="name">clinic.patient.search</field>
            <field name="model">res.partner</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <search string="Rechercher Patient">
                    <field name="name" string="Patient/N° Dossier"/>
                    <field name="patient_number"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <separator/>
                    <filter name="filter_male" string="Homme" domain="[('gender','=','male')]"/>
                    <filter name="filter_female" string="Femme" domain="[('gender','=','female')]"/>
                    <filter name="filter_active" string="Actifs" domain="[('patient_status','=','active')]"/>
                    <filter name="filter_inactive" string="Inactifs" domain="[('patient_status','=','inactive')]"/>
                    <separator/>
                    <filter name="filter_with_insurance" string="Assurés" domain="[('insurance_number','!=',False)]"/>
                </search>
            </field>
        </record>

        <!-- Vue Graphique des Patients -->
        <record id="view_clinic_patient_graph" model="ir.ui.view">
            <field name="name">clinic.patient.graph</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <graph string="Statistiques Patients" type="bar">
                    <field name="gender" type="row"/>
                    <field name="patient_status" type="col"/>
                </graph>
            </field>
        </record>

        <!-- Vue Pivot des Patients -->
        <record id="view_clinic_patient_pivot" model="ir.ui.view">
            <field name="name">clinic.patient.pivot</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <pivot string="Analyse Patients">
                    <field name="gender" type="row"/>
                    <field name="patient_status" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- Action pour les patients -->
        <record id="action_clinic_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,list,form,graph,pivot</field>
            <field name="domain">[('is_patient', '=', True)]</field>
            <field name="context">{'default_is_patient': True}</field>
            <field name="search_view_id" ref="view_clinic_patient_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau patient
                </p>
                <p>
                    Cliquez sur "Créer" pour enregistrer un nouveau patient dans le système.
                </p>
            </field>
        </record>
    </data>
</odoo>
