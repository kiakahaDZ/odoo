<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════
         RAPPORT : Ticket de Caisse
    ════════════════════════════════════════ -->
    <record id="action_report_barber_receipt" model="ir.actions.report">
        <field name="name">Ticket de Caisse</field>
        <field name="model">barber.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">barber_pos.report_barber_receipt</field>
        <field name="report_file">barber_pos.report_barber_receipt</field>
        <field name="binding_model_id" ref="model_barber_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_barber_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Courier New', monospace; max-width: 80mm; margin: auto;">

                        <!-- En-tête salon -->
                        <div class="text-center mb-3">
                            <t t-if="order.session_id.barber_id.photo">
                                <!-- logo si dispo -->
                            </t>
                            <h3 style="border-bottom: 2px solid #000; padding-bottom: 8px;">
                                💈 SALON DE COIFFURE
                            </h3>
                            <t t-set="config" t-value="env['barber.config'].get_current_config()"/>
                            <p class="mb-0"><strong><t t-esc="config.salon_name"/></strong></p>
                            <p class="mb-0 small"><t t-esc="config.phone"/></p>
                            <p class="small text-muted"><t t-esc="config.receipt_header"/></p>
                        </div>

                        <!-- Infos ticket -->
                        <div style="border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 6px 0; margin-bottom: 8px;">
                            <table style="width:100%; font-size: 11px;">
                                <tr>
                                    <td><strong>N° Ticket :</strong></td>
                                    <td class="text-end"><t t-esc="order.name"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Date :</strong></td>
                                    <td class="text-end">
                                        <t t-esc="order.date_order" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Coiffeur :</strong></td>
                                    <td class="text-end"><t t-esc="order.barber_id.name"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- Lignes de prestations -->
                        <div style="margin-bottom: 8px;">
                            <table style="width:100%; font-size: 11px;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #000;">
                                        <th>Prestation</th>
                                        <th class="text-center">Qté</th>
                                        <th class="text-end">Prix</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="order.order_line_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <t t-esc="line.service_id.name"/>
                                                <t t-if="line.discount > 0">
                                                    <br/><small class="text-muted">Remise: <t t-esc="line.discount"/>%</small>
                                                </t>
                                            </td>
                                            <td class="text-center"><t t-esc="line.qty"/></td>
                                            <td class="text-end"><t t-esc="line.unit_price"/> DZD</td>
                                            <td class="text-end"><t t-esc="line.subtotal"/> DZD</td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Totaux -->
                        <div style="border-top: 2px solid #000; padding-top: 6px; margin-bottom: 8px;">
                            <table style="width:100%; font-size: 12px;">
                                <t t-if="order.tax_rate > 0">
                                    <tr>
                                        <td>Sous-total HT</td>
                                        <td class="text-end"><t t-esc="order.amount_untaxed"/> DZD</td>
                                    </tr>
                                    <tr>
                                        <td>TVA (<t t-esc="order.tax_rate"/>%)</td>
                                        <td class="text-end"><t t-esc="order.amount_tax"/> DZD</td>
                                    </tr>
                                </t>
                                <tr style="font-size: 15px; font-weight: bold; border-top: 1px dashed #000;">
                                    <td>TOTAL TTC</td>
                                    <td class="text-end"><t t-esc="order.amount_total"/> DZD</td>
                                </tr>
                                <tr>
                                    <td>Payé (<t t-esc="dict(order._fields['payment_method'].selection)[order.payment_method]"/>)</td>
                                    <td class="text-end"><t t-esc="order.amount_paid"/> DZD</td>
                                </tr>
                                <t t-if="order.amount_change > 0">
                                    <tr>
                                        <td>Monnaie rendue</td>
                                        <td class="text-end"><t t-esc="order.amount_change"/> DZD</td>
                                    </tr>
                                </t>
                            </table>
                        </div>

                        <!-- Pied de ticket -->
                        <div class="text-center" style="border-top: 1px dashed #000; padding-top: 8px;">
                            <p class="small"><t t-esc="config.receipt_footer"/></p>
                            <p style="font-size: 9px; color: #999;">
                                Session: <t t-esc="order.session_id.name"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

