<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════
         VUES : Commandes POS
    ════════════════════════════════════════════════════ -->

    <record id="view_barber_order_list" model="ir.ui.view">
        <field name="name">barber.order.list</field>
        <field name="model">barber.order</field>
        <field name="arch" type="xml">
            <list string="Commandes" decoration-success="state == 'paid'"
                  decoration-danger="state == 'cancelled'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="barber_id"/>
                <field name="session_id"/>
                <field name="payment_method"/>
                <field name="amount_total"/>
                <field name="amount_paid" optional="hide"/>
                <field name="amount_change" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_barber_order_form" model="ir.ui.view">
        <field name="name">barber.order.form</field>
        <field name="model">barber.order</field>
        <field name="arch" type="xml">
            <form string="Commande / Ticket">
                <header>
                    <button name="action_pay" type="object"
                            string="💳 Payer" class="btn-success"
                            invisible="state != 'draft'"/>
                    <button name="action_print_receipt" type="object"
                            string="🖨️ Imprimer Ticket" class="btn-secondary"
                            invisible="state != 'paid'"/>
                    <button name="action_cancel" type="object"
                            string="❌ Annuler" class="btn-danger"
                            invisible="state != 'draft'"
                            groups="barber_pos.group_barber_manager"/>
                    <button name="action_reset_draft" type="object"
                            string="♻️ Remettre en cours" class="btn-secondary"
                            invisible="state != 'cancelled'"
                            groups="barber_pos.group_barber_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="📋 Informations">
                            <field name="session_id"
                                   domain="[('state', '=', 'open')]"
                                   readonly="state != 'draft'"/>
                            <field name="barber_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date_order" readonly="state != 'draft'"/>
                        </group>
                        <group string="💰 Paiement" invisible="state == 'draft'">
                            <field name="payment_method" readonly="state == 'paid'"/>
                            <field name="amount_paid" readonly="state == 'paid'"/>
                            <field name="amount_change" readonly="1"/>
                            <field name="points_used" invisible="points_used == 0"/>
                            <field name="points_amount" invisible="points_used == 0"/>
                            <field name="points_earned" invisible="state != 'paid'"/>
                        </group>
                    </group>

                    <!-- Lignes de prestations -->
                    <field name="order_line_ids" readonly="state != 'draft'">
                        <list string="Prestations" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="service_id"
                                   domain="[('active', '=', True)]"/>
                            <field name="category_id" readonly="1"/>
                            <field name="qty"/>
                            <field name="unit_price"
                                   readonly="not allow_price_override"/>
                            <field name="discount"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="allow_price_override" column_invisible="True"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>

                    <!-- Totaux -->
                    <div class="row justify-content-end mt-3">
                        <div class="col-md-4">
                            <table class="table table-borderless">
                                <tr invisible="tax_rate == 0">
                                    <td class="text-end text-muted">Sous-total HT</td>
                                    <td class="text-end fw-bold">
                                        <field name="amount_untaxed"/> DZD
                                    </td>
                                </tr>
                                <tr invisible="tax_rate == 0">
                                    <td class="text-end text-muted">
                                        TVA (<field name="tax_rate"/>%)
                                    </td>
                                    <td class="text-end">
                                        <field name="amount_tax"/> DZD
                                    </td>
                                </tr>
                                <tr class="border-top">
                                    <td class="text-end fw-bold fs-5">Total TTC</td>
                                    <td class="text-end fw-bold fs-5 text-success">
                                        <field name="amount_total"/> DZD
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <group string="📝 Note client">
                        <field name="note" nolabel="1"
                               placeholder="Remarques sur le client ou la prestation..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_barber_order_search" model="ir.ui.view">
        <field name="name">barber.order.search</field>
        <field name="model">barber.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="barber_id"/>
            </search>
        </field>
    </record>

    <record id="action_barber_order" model="ir.actions.act_window">
        <field name="name">🧾 Commandes &amp; Tickets</field>
        <field name="res_model">barber.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_barber_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune commande enregistrée
            </p>
            <p>Ouvrez une session POS et commencez à enregistrer vos prestations.</p>
        </field>
    </record>

    <!-- Action "Mes Commandes" pour coiffeur -->
    <record id="action_my_barber_orders" model="ir.actions.act_window">
        <field name="name">🧾 Mes Commandes</field>
        <field name="res_model">barber.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('barber_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_filter_date_today': 1}</field>
    </record>
</odoo>

