<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════
         DASHBOARD ADMINISTRATEUR
    ════════════════════════════════════════ -->
    <record id="view_barber_dashboard" model="ir.ui.view">
        <field name="name">barber.dashboard</field>
        <field name="model">barber.session</field>
        <field name="arch" type="xml">
            <graph string="CA par Coiffeur" type="bar">
                <field name="barber_id"/>
                <field name="total_revenue" type="measure"/>
                <field name="order_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_barber_dashboard_pivot" model="ir.ui.view">
        <field name="name">barber.dashboard.pivot</field>
        <field name="model">barber.session</field>
        <field name="arch" type="xml">
            <pivot string="Statistiques Sessions">
                <field name="barber_id" type="row"/>
                <field name="date_open" type="col" interval="month"/>
                <field name="total_revenue" type="measure"/>
                <field name="order_count" type="measure"/>
                <field name="total_cash" type="measure"/>
                <field name="total_card" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_barber_dashboard" model="ir.actions.act_window">
        <field name="name">📊 Tableau de Bord</field>
        <field name="res_model">barber.session</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('state', '=', 'closed')]</field>
    </record>

    <!-- Rapport CA par coiffeur (orders groupés) -->
    <record id="view_barber_order_pivot" model="ir.ui.view">
        <field name="name">barber.order.pivot</field>
        <field name="model">barber.order</field>
        <field name="arch" type="xml">
            <pivot string="CA par Coiffeur">
                <field name="barber_id" type="row"/>
                <field name="date_order" type="col" interval="month"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_barber_order_graph" model="ir.ui.view">
        <field name="name">barber.order.graph</field>
        <field name="model">barber.order</field>
        <field name="arch" type="xml">
            <graph string="Chiffre d'Affaires" type="bar" stacked="True">
                <field name="barber_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_barber_stats" model="ir.actions.act_window">
        <field name="name">📈 Statistiques CA</field>
        <field name="res_model">barber.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('state', '=', 'paid')]</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>
</odoo>

