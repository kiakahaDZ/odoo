<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template de base de l'interface POS -->
    <template id="barber_pos_index" name="Barber POS Interface">
        <t t-call="web.layout">
            <t t-set="head">
                <title>Barber POS - <t t-esc="session.name"/></title>
                <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
                
                <t t-call-assets="web.assets_backend" t-js="false"/>
                <t t-call-assets="web.assets_common" t-js="false"/>
                
                <link rel="stylesheet" href="/barber_pos/static/src/css/barber_pos.css"/>
            </t>

            <div id="barber_pos_app" class="o_action_manager">
                <!-- L'interface sera injectée ici par OWL ou servie en QWeb pur -->
                <div class="container-fluid p-0 d-flex flex-column" style="height: 100vh; background-color: #f8f9fa;">
                    <!-- Barre de navigation -->
                    <nav class="navbar navbar-dark bg-dark shadow-sm">
                        <div class="container-fluid">
                            <span class="navbar-brand mb-0 h1">
                                💈 <t t-esc="company.name"/> | <t t-esc="session.name"/>
                            </span>
                            <div class="d-flex align-items-center text-white">
                                <span class="me-3">👤 <t t-esc="barber.name"/></span>
                                <a href="/odoo" class="btn btn-outline-light btn-sm">Quitter</a>
                            </div>
                        </div>
                    </nav>

                    <!-- Corps de l'interface -->
                    <div class="flex-grow-1 d-flex overflow-hidden">
                        <!-- Liste des services (Gauche) -->
                        <div class="col-md-8 p-3 overflow-auto">
                            <h4 class="mb-3">✂️ Prestations</h4>
                            <div class="row g-3" id="services_list">
                                <!-- Les services seront chargés ici -->
                                <p class="text-muted">Chargement des prestations...</p>
                            </div>
                        </div>

                        <!-- Panier et Paiement (Droite) -->
                        <div class="col-md-4 bg-white border-start d-flex flex-column">
                            <div class="p-3 border-bottom bg-light">
                                <h4 class="mb-0">🧾 Ticket en cours</h4>
                            </div>
                            <!-- Sélection Client -->
                            <div class="p-2 border-bottom">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">👤</span>
                                    <select class="form-select border-start-0" id="customer_select">
                                        <option value="">-- Sélectionner un client --</option>
                                    </select>
                                </div>
                                <div id="customer_vip_info" class="mt-2 small text-success fw-bold" style="display:none;">
                                    ⭐ Points: <span id="customer_points">0</span> (Valeur: <span id="customer_points_val">0</span> DZD)
                                </div>
                            </div>
                            <div class="flex-grow-1 p-3 overflow-auto" id="current_order_lines">
                                <p class="text-center text-muted mt-5">Le panier est vide</p>
                            </div>
                            <div class="p-3 border-top mt-auto">
                                <div class="d-flex justify-content-between fs-4 fw-bold mb-3">
                                    <span>Total</span>
                                    <span id="order_total">0.00 DZD</span>
                                </div>
                                <button class="btn btn-success btn-lg w-100 shadow-sm" id="btn_pay_order">
                                    💳 ENCAISSER
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chargement des Scripts -->
            <script type="text/javascript">
                var odoo_info = {
                    session_id: <t t-esc="session.id"/>,
                    barber_id: <t t-esc="barber.id"/>,
                    currency_symbol: "<t t-esc="session.currency_id.symbol"/>"
                };
            </script>
            <t t-call-assets="web.assets_common" t-css="false"/>
            <t t-call-assets="web.assets_backend" t-css="false"/>
            <script type="text/javascript" src="/barber_pos/static/src/js/barber_dashboard.js"></script>
        </t>
    </template>
</odoo>

