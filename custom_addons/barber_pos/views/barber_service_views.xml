<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════
         VUES : Catégories de Prestations
    ════════════════════════════════════════════════════ -->
    <record id="view_barber_service_category_list" model="ir.ui.view">
        <field name="name">barber.service.category.list</field>
        <field name="model">barber.service.category</field>
        <field name="arch" type="xml">
            <list string="Catégories de Prestations" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="service_count"/>
                <field name="color" widget="color_picker"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_barber_service_category_form" model="ir.ui.view">
        <field name="name">barber.service.category.form</field>
        <field name="model">barber.service.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie">
                <sheet>
                    <group>
                        <field name="icon"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_barber_service_category" model="ir.actions.act_window">
        <field name="name">📁 Catégories</field>
        <field name="res_model">barber.service.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ════════════════════════════════════════════════════
         VUES : Prestations (Services)
    ════════════════════════════════════════════════════ -->

    <!-- Liste Prestations -->
    <record id="view_barber_service_list" model="ir.ui.view">
        <field name="name">barber.service.list</field>
        <field name="model">barber.service</field>
        <field name="arch" type="xml">
            <list string="Prestations" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="category_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="barber_type"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="duration"/>
                <field name="margin" widget="percentage"/>
                <field name="order_count"/>
                <field name="active" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Kanban Prestations -->
    <record id="view_barber_service_kanban" model="ir.ui.view">
        <field name="name">barber.service.kanban</field>
        <field name="model">barber.service</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="category_id">
                <field name="name"/>
                <field name="price"/>
                <field name="duration"/>
                <field name="barber_type"/>
                <field name="category_id"/>
                <field name="active"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value}">
                            <div class="oe_kanban_content p-2">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="text-muted small">
                                    <field name="category_id"/>
                                    <span t-if="record.code.raw_value"> · <field name="code"/></span>
                                </div>
                                <div class="mt-2 d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success fs-6">
                                        <field name="price"/> DZD
                                    </span>
                                    <span class="text-muted small">
                                        ⏱ <field name="duration"/> min
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Formulaire Prestation -->
    <record id="view_barber_service_form" model="ir.ui.view">
        <field name="name">barber.service.form</field>
        <field name="model">barber.service</field>
        <field name="arch" type="xml">
            <form string="Prestation">
                <header>
                    <button name="action_archive" type="object" string="Archiver"
                            class="btn-secondary"
                            invisible="not active"/>
                    <button name="action_unarchive" type="object" string="Réactiver"
                            class="btn-primary"
                            invisible="active"/>
                    <button name="action_view_orders" type="object"
                            string="Voir les commandes" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_orders" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Commandes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom de la prestation..."/></h1>
                        <h4 class="text-muted">
                            <field name="code" placeholder="Code court (ex: COUPE-H)"/>
                        </h4>
                    </div>
                    <group>
                        <group string="📋 Informations">
                            <field name="category_id"/>
                            <field name="barber_type"/>
                            <field name="duration"/>
                            <field name="sequence"/>
                        </group>
                        <group string="💰 Tarification">
                            <field name="price"/>
                            <field name="price_min"/>
                            <field name="allow_price_override"/>
                            <field name="material_cost" readonly="1"/>
                            <field name="margin" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="🧴 Produits consommés" name="products">
                            <field name="product_line_ids">
                                <list string="Produits utilisés" editable="bottom">
                                    <field name="product_id" domain="[('type', 'in', ['consu', 'product'])]"/>
                                    <field name="product_name" readonly="1"/>
                                    <field name="qty"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="cost" readonly="1"/>
                                    <field name="total_cost" readonly="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="📝 Description" name="description">
                            <field name="description" placeholder="Description de la prestation..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Recherche Prestations -->
    <record id="view_barber_service_search" model="ir.ui.view">
        <field name="name">barber.service.search</field>
        <field name="model">barber.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <!-- Action Prestations -->
    <record id="action_barber_service" model="ir.actions.act_window">
        <field name="name">✂️ Prestations &amp; Tarifs</field>
        <field name="res_model">barber.service</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_barber_service_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune prestation configurée
            </p>
            <p>Créez vos premières prestations (coupes, barbe, soins…) avec leurs tarifs.</p>
        </field>
    </record>
</odoo>

