<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════
         VUES : Sessions POS
    ════════════════════════════════════════════════════ -->

    <record id="view_barber_session_list" model="ir.ui.view">
        <field name="name">barber.session.list</field>
        <field name="model">barber.session</field>
        <field name="arch" type="xml">
            <list string="Sessions POS" decoration-success="state == 'open'"
                  decoration-warning="state == 'closing'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="barber_id"/>
                <field name="date_open"/>
                <field name="date_close"/>
                <field name="duration" widget="float_time"/>
                <field name="order_count"/>
                <field name="total_revenue"/>
                <field name="total_cash"/>
                <field name="total_card"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-warning="state == 'closing'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_barber_session_form" model="ir.ui.view">
        <field name="name">barber.session.form</field>
        <field name="model">barber.session</field>
        <field name="arch" type="xml">
            <form string="Session POS">
                <header>
                    <button name="action_new_order" type="object"
                            string="➕ Nouvelle Commande" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_view_pos_interface" type="object"
                            string="🖥️ Ouvrir la Caisse" class="btn-success"
                            invisible="state != 'open'"/>
                    <button name="action_close_session" type="object"
                            string="🔴 Fermer la Session" class="btn-warning"
                            invisible="state != 'open'"/>
                    <button name="action_reopen" type="object"
                            string="🟢 Rouvrir" class="btn-secondary"
                            invisible="state == 'open'"
                            groups="barber_pos.group_barber_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,closing,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_new_order" icon="fa-shopping-cart"
                                invisible="state != 'open'">
                            <field name="order_count" widget="statinfo" string="Commandes"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-money">
                            <field name="total_revenue" widget="statinfo" string="CA Session"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="👤 Coiffeur">
                            <field name="barber_id" readonly="state != 'open'"/>
                            <field name="date_open" readonly="1"/>
                            <field name="date_close" readonly="1"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                        <group string="💰 Caisse">
                            <field name="cash_in" readonly="state != 'open'"/>
                            <field name="cash_out" readonly="1"/>
                            <field name="cash_difference" readonly="1"/>
                        </group>
                    </group>

                    <!-- Résumé financier de la session -->
                    <div class="row mt-3" invisible="state == 'open'">
                        <div class="col-md-12">
                            <h4>📊 Résumé de la Session</h4>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center p-3 border-success">
                                <div class="fs-4 fw-bold text-success">
                                    <field name="total_revenue"/> DZD
                                </div>
                                <div class="text-muted">CA Total</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center p-3">
                                <div class="fs-4 fw-bold">
                                    <field name="total_cash"/> DZD
                                </div>
                                <div class="text-muted">💵 Espèces</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center p-3">
                                <div class="fs-4 fw-bold">
                                    <field name="total_card"/> DZD
                                </div>
                                <div class="text-muted">💳 Carte</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center p-3">
                                <div class="fs-4 fw-bold">
                                    <field name="total_mobile"/> DZD
                                </div>
                                <div class="text-muted">📱 Mobile</div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4 mb-4">
                        <div class="col-md-6">
                            <div class="card p-3 border-success">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="fw-bold">🌟 Points VIP distribués</div>
                                    <div class="fs-5"><field name="total_points_earned"/> pts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card p-3 border-primary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="fw-bold">⭐ Points VIP consommés</div>
                                    <div class="fs-5"><field name="total_points_used"/> pts</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="🧾 Commandes" name="orders">
                            <field name="order_ids" readonly="1">
                                <list decoration-success="state == 'paid'"
                                      decoration-danger="state == 'cancelled'">
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="order_line_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                    <field name="payment_method"/>
                                    <field name="amount_total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="📝 Notes" name="notes">
                            <field name="notes" placeholder="Notes de session..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_barber_session_search" model="ir.ui.view">
        <field name="name">barber.session.search</field>
        <field name="model">barber.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="barber_id"/>
            </search>
        </field>
    </record>

    <record id="action_barber_session" model="ir.actions.act_window">
        <field name="name">🟢 Sessions POS</field>
        <field name="res_model">barber.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_barber_session_search"/>
        <field name="context">{'search_default_filter_state_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune session ouverte
            </p>
            <p>Ouvrez une session depuis la fiche d'un coiffeur pour démarrer la caisse.</p>
        </field>
    </record>

    <!-- Action "Ma Session" pour les coiffeurs -->
    <record id="action_my_barber_session" model="ir.actions.act_window">
        <field name="name">🖥️ Ma Caisse</field>
        <field name="res_model">barber.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('barber_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_filter_state_open': 1}</field>
    </record>
</odoo>

