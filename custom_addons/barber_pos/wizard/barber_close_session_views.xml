<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_barber_close_session_wizard_form" model="ir.ui.view">
        <field name="name">barber.close.session.wizard.form</field>
        <field name="model">barber.close.session.wizard</field>
        <field name="arch" type="xml">
            <form string="🔴 Fermeture de Session">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>⚠️ Vous êtes sur le point de fermer la session.</strong>
                        Cette action est définitive. Vérifiez le montant de la caisse avant de confirmer.
                    </div>
                    <group>
                        <field name="session_id" readonly="1"/>
                        <field name="cash_out"
                               string="Montant en caisse à la fermeture"/>
                        <field name="notes"
                               placeholder="Remarques de clôture optionnelles..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_close" type="object"
                            string="🔴 Confirmer la fermeture"
                            class="btn-danger"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

