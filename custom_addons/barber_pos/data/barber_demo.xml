<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ═══ Catégories de prestations ═══ -->
        <record id="cat_coiffure" model="barber.service.category">
            <field name="name">💇 Coiffure</field>
            <field name="sequence">1</field>
            <field name="color">1</field>
            <field name="icon">💇</field>
            <field name="description">Coupes et soins capillaires pour femmes et hommes</field>
        </record>

        <record id="cat_barbe" model="barber.service.category">
            <field name="name">🪒 Barbe &amp; Rasage</field>
            <field name="sequence">2</field>
            <field name="color">2</field>
            <field name="icon">🪒</field>
            <field name="description">Taille et rasage de barbe professionnels</field>
        </record>

        <record id="cat_soins" model="barber.service.category">
            <field name="name">💆 Soins &amp; Beauté</field>
            <field name="sequence">3</field>
            <field name="color">4</field>
            <field name="icon">💆</field>
            <field name="description">Soins du visage, hydratation, masques</field>
        </record>

        <record id="cat_coloration" model="barber.service.category">
            <field name="name">🎨 Coloration</field>
            <field name="sequence">4</field>
            <field name="color">6</field>
            <field name="icon">🎨</field>
            <field name="description">Colorations, mèches et décolorations</field>
        </record>

        <record id="cat_packages" model="barber.service.category">
            <field name="name">💎 Forfaits</field>
            <field name="sequence">5</field>
            <field name="color">10</field>
            <field name="icon">💎</field>
            <field name="description">Forfaits combinés à tarifs préférentiels</field>
        </record>

        <!-- ═══ Prestations : Coiffure ═══ -->
        <record id="svc_coupe_homme" model="barber.service">
            <field name="name">Coupe Homme</field>
            <field name="code">COUPE-H</field>
            <field name="category_id" ref="cat_coiffure"/>
            <field name="price">500</field>
            <field name="duration">30</field>
            <field name="barber_type">hair</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">1</field>
        </record>

        <record id="svc_coupe_enfant" model="barber.service">
            <field name="name">Coupe Enfant (- 12 ans)</field>
            <field name="code">COUPE-E</field>
            <field name="category_id" ref="cat_coiffure"/>
            <field name="price">300</field>
            <field name="duration">20</field>
            <field name="barber_type">hair</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">2</field>
        </record>

        <record id="svc_degrade" model="barber.service">
            <field name="name">Dégradé / Fondu</field>
            <field name="code">DEGRADE</field>
            <field name="category_id" ref="cat_coiffure"/>
            <field name="price">700</field>
            <field name="duration">45</field>
            <field name="barber_type">both</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">3</field>
        </record>

        <record id="svc_lavage_coupe" model="barber.service">
            <field name="name">Lavage + Coupe</field>
            <field name="code">LAV-COUPE</field>
            <field name="category_id" ref="cat_coiffure"/>
            <field name="price">800</field>
            <field name="duration">50</field>
            <field name="barber_type">hair</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">4</field>
        </record>

        <!-- ═══ Prestations : Barbe ═══ -->
        <record id="svc_barbe_taille" model="barber.service">
            <field name="name">Taille de Barbe</field>
            <field name="code">BARBE-T</field>
            <field name="category_id" ref="cat_barbe"/>
            <field name="price">300</field>
            <field name="duration">20</field>
            <field name="barber_type">barber</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">1</field>
        </record>

        <record id="svc_rasage_complet" model="barber.service">
            <field name="name">Rasage Complet (Lame)</field>
            <field name="code">RASAGE</field>
            <field name="category_id" ref="cat_barbe"/>
            <field name="price">400</field>
            <field name="duration">25</field>
            <field name="barber_type">barber</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">2</field>
        </record>

        <record id="svc_barbe_design" model="barber.service">
            <field name="name">Design de Barbe</field>
            <field name="code">BARBE-D</field>
            <field name="category_id" ref="cat_barbe"/>
            <field name="price">500</field>
            <field name="duration">35</field>
            <field name="barber_type">barber</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">3</field>
        </record>

        <!-- ═══ Prestations : Soins ═══ -->
        <record id="svc_soin_visage" model="barber.service">
            <field name="name">Soin Visage Hydratant</field>
            <field name="code">SOIN-V</field>
            <field name="category_id" ref="cat_soins"/>
            <field name="price">600</field>
            <field name="duration">40</field>
            <field name="barber_type">care</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">1</field>
        </record>

        <record id="svc_masque" model="barber.service">
            <field name="name">Masque Capillaire</field>
            <field name="code">MASQUE</field>
            <field name="category_id" ref="cat_soins"/>
            <field name="price">500</field>
            <field name="duration">30</field>
            <field name="barber_type">care</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">2</field>
        </record>

        <!-- ═══ Prestations : Coloration ═══ -->
        <record id="svc_coloration_simple" model="barber.service">
            <field name="name">Coloration Simple</field>
            <field name="code">COLOR-S</field>
            <field name="category_id" ref="cat_coloration"/>
            <field name="price">1500</field>
            <field name="duration">90</field>
            <field name="barber_type">hair</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">1</field>
        </record>

        <record id="svc_meches" model="barber.service">
            <field name="name">Mèches / Balayage</field>
            <field name="code">MECHES</field>
            <field name="category_id" ref="cat_coloration"/>
            <field name="price">2500</field>
            <field name="duration">120</field>
            <field name="barber_type">hair</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">2</field>
        </record>

        <!-- ═══ Forfaits ═══ -->
        <record id="svc_forfait_complet" model="barber.service">
            <field name="name">Forfait Complet (Coupe + Barbe)</field>
            <field name="code">FORFAIT-CB</field>
            <field name="category_id" ref="cat_packages"/>
            <field name="price">750</field>
            <field name="price_min">700</field>
            <field name="duration">60</field>
            <field name="barber_type">both</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">1</field>
        </record>

        <record id="svc_forfait_vip" model="barber.service">
            <field name="name">Forfait VIP (Coupe + Barbe + Soin)</field>
            <field name="code">FORFAIT-VIP</field>
            <field name="category_id" ref="cat_packages"/>
            <field name="price">1200</field>
            <field name="price_min">1100</field>
            <field name="duration">90</field>
            <field name="barber_type">both</field>
            <field name="allow_price_override">True</field>
            <field name="sequence">2</field>
        </record>

        <!-- ═══ Configuration par défaut ═══ -->
        <record id="barber_config_default" model="barber.config">
            <field name="salon_name">Mon Salon de Coiffure</field>
            <field name="phone">+213 XX XX XX XX</field>
            <field name="receipt_header">✂️ Bienvenue dans notre salon !
Nous vous souhaitons une excellente expérience.</field>
            <field name="receipt_footer">Merci de votre visite ! 💈
Revenez bientôt — Votre satisfaction est notre priorité.</field>
            <field name="tax_rate">0</field>
        </record>
    </data>
</odoo>

