<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem id="menu_clinic_reporting"
                  name="Rapports"
                  parent="clinic_patient.menu_clinic_root"
                  sequence="90"/>

        <!-- Rapport Actes Médicaux -->
        <record id="action_report_medical_acts_graph" model="ir.actions.act_window">
            <field name="name">Analyse des Actes</field>
            <field name="res_model">clinic.medical.act.line</field>
            <field name="view_mode">graph,pivot,list</field>
            <field name="domain">[('state', 'in', ['paid', 'done'])]</field>
            <field name="context">{'group_by': 'medical_act_type'}</field>
        </record>

        <menuitem id="menu_report_medical_acts"
                  name="Actes Médicaux"
                  parent="menu_clinic_reporting"
                  action="action_report_medical_acts_graph"
                  sequence="10"/>
                  
        <!-- Rapport Honoraires Médecins -->
        <record id="action_report_doctor_fees" model="ir.actions.act_window">
            <field name="name">Honoraires Médecins</field>
            <field name="res_model">clinic.medical.act.line</field>
            <field name="view_mode">pivot,list</field>
            <field name="domain">[('state', 'in', ['paid', 'done'])]</field>
            <field name="context">{'group_by': 'doctor_id'}</field>
        </record>
        
        <menuitem id="menu_report_doctor_fees"
                  name="Honoraires &amp; Commissions"
                  parent="menu_clinic_reporting"
                  action="action_report_doctor_fees"
                  sequence="20"/>

        <!-- Rapport Chiffre d'Affaires -->
        <record id="action_report_revenue" model="ir.actions.act_window">
            <field name="name">Chiffre d'Affaires</field>
            <field name="res_model">clinic.medical.act.line</field>
            <field name="view_mode">graph,list</field>
            <field name="domain">[('state', 'in', ['paid', 'done'])]</field>
            <field name="context">{'group_by': 'date:month'}</field>
        </record>

        <menuitem id="menu_report_revenue"
                  name="Chiffre d'Affaires"
                  parent="menu_clinic_reporting"
                  action="action_report_revenue"
                  sequence="30"/>

        <!-- Rapport Fréquentation Patients -->
        <record id="action_report_patient_visits" model="ir.actions.act_window">
            <field name="name">Fréquentation Patients</field>
            <field name="res_model">clinic.medical.act.line</field>
            <field name="view_mode">list</field>
            <field name="domain">[('state', 'in', ['paid', 'done'])]</field>
            <field name="context">{'group_by': 'patient_id'}</field>
        </record>

        <menuitem id="menu_report_patient_visits"
                  name="Fréquentation Patients"
                  parent="menu_clinic_reporting"
                  action="action_report_patient_visits"
                  sequence="40"/>

        <!-- Rapport Services/Types d'Actes -->
        <record id="action_report_services" model="ir.actions.act_window">
            <field name="name">Par Type de Service</field>
            <field name="res_model">clinic.medical.act.line</field>
            <field name="view_mode">list</field>
            <field name="domain">[('state', 'in', ['paid', 'done'])]</field>
            <field name="context">{'group_by': 'service_type'}</field>
        </record>

        <menuitem id="menu_report_services"
                  name="Par Type de Service"
                  parent="menu_clinic_reporting"
                  action="action_report_services"
                  sequence="50"/>
    </data>
</odoo>

