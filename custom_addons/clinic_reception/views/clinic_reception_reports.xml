<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue Graphique - Actes par Type de Consultation -->
        <record id="view_clinic_reception_graph_acts" model="ir.ui.view">
            <field name="name">clinic.reception.graph.acts</field>
            <field name="model">clinic.reception</field>
            <field name="arch" type="xml">
                <graph string="Réceptions par État" type="pie">
                    <field name="state" type="row"/>
                </graph>
            </field>
        </record>

        <!-- Mise à jour de l'action pour inclure les nouvelles vues -->
        <record id="action_clinic_reception" model="ir.actions.act_window">
            <field name="name">Tickets de Réception</field>
            <field name="res_model">clinic.reception</field>
            <field name="view_mode">list,form,graph</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau ticket de réception
                </p>
            </field>
        </record>
    </data>
</odoo>

