<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template du ticket de caisse -->
    <template id="clinic_receipt_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: 'Courier New', monospace; font-size: 12px; width: 80mm; margin: 0 auto; padding: 10px;">
                    <!-- En-tête de la clinique -->
                    <div style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 10px; margin-bottom: 10px;">
                        <div style="font-size: 18px; font-weight: bold; margin-bottom: 5px;">
                            <t t-esc="doc.env.company.name or 'CLINIQUE'"/>
                        </div>
                        <div style="font-size: 11px; margin-bottom: 3px;">
                            <t t-if="doc.env.company.street">
                                <t t-esc="doc.env.company.street"/>
                            </t>
                        </div>
                        <div style="font-size: 11px; margin-bottom: 3px;">
                            <t t-if="doc.env.company.city">
                                <t t-esc="doc.env.company.city"/>
                                <t t-if="doc.env.company.zip">, <t t-esc="doc.env.company.zip"/></t>
                            </t>
                        </div>
                        <div style="font-size: 11px; margin-bottom: 3px;">
                            <t t-if="doc.env.company.phone">
                                Tel: <t t-esc="doc.env.company.phone"/>
                            </t>
                        </div>
                        <div style="font-size: 10px; margin-top: 5px;">
                            <t t-if="doc.env.company.vat">
                                NIF: <t t-esc="doc.env.company.vat"/>
                            </t>
                        </div>
                    </div>

                    <!-- Informations du ticket -->
                    <div style="margin-bottom: 10px;">
                        <div style="text-align: center; font-weight: bold; font-size: 14px; margin-bottom: 10px;">
                            TICKET DE CAISSE
                        </div>
                        <table style="width: 100%; font-size: 11px; margin-bottom: 8px;">
                            <tr>
                                <td style="width: 40%;">Reference:</td>
                                <td style="font-weight: bold;"><t t-esc="doc.name"/></td>
                            </tr>
                            <tr>
                                <td>Date:</td>
                                <td><t t-esc="doc.get_receipt_date_formatted()"/></td>
                            </tr>
                            <tr>
                                <td>Caissier:</td>
                                <td><t t-esc="(doc.cashier_id and doc.cashier_id.name) or doc.env.user.name"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- Informations patient -->
                    <div style="border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 8px 0; margin-bottom: 10px;">
                        <div style="font-weight: bold; margin-bottom: 5px;">PATIENT</div>
                        <table style="width: 100%; font-size: 11px;">
                            <tr>
                                <td style="width: 40%;">Nom:</td>
                                <td><t t-esc="doc.patient_id.name"/></td>
                            </tr>
                            <t t-if="doc.patient_id.phone">
                                <tr>
                                    <td>Telephone:</td>
                                    <td><t t-esc="doc.patient_id.phone"/></td>
                                </tr>
                            </t>
                            <t t-if="doc.patient_id.ref">
                                <tr>
                                    <td>No Dossier:</td>
                                    <td><t t-esc="doc.patient_id.ref"/></td>
                                </tr>
                            </t>
                        </table>
                    </div>

                    <!-- Détails des actes -->
                    <div style="margin-bottom: 10px;">
                        <div style="font-weight: bold; margin-bottom: 5px; border-bottom: 1px solid #000; padding-bottom: 3px;">
                            DÉTAILS DES ACTES
                        </div>
                        <table style="width: 100%; font-size: 10px; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 1px dashed #000;">
                                    <th style="text-align: left; padding: 3px 0;">Acte</th>
                                    <th style="text-align: center; padding: 3px 0;">Qté</th>
                                    <th style="text-align: right; padding: 3px 0;">Prix</th>
                                    <th style="text-align: right; padding: 3px 0;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.visit_line_ids" t-as="line">
                                    <tr style="border-bottom: 1px dotted #ccc;">
                                        <td style="padding: 4px 0;">
                                            <t t-esc="line.product_id.name"/>
                                        </td>
                                        <td style="text-align: center; padding: 4px 0;">
                                            <t t-esc="int(line.quantity) if line.quantity == int(line.quantity) else '%.2f' % line.quantity"/>
                                        </td>
                                        <td style="text-align: right; padding: 4px 0;">
                                            <t t-esc="doc.get_receipt_amount_formatted(line.unit_price)"/>
                                        </td>
                                        <td style="text-align: right; padding: 4px 0; font-weight: bold;">
                                            <t t-esc="doc.get_receipt_amount_formatted(line.subtotal)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Total et mode de paiement -->
                    <div style="border-top: 2px solid #000; padding-top: 8px; margin-top: 10px;">
                        <table style="width: 100%; font-size: 12px; font-weight: bold;">
                            <tr>
                                <td style="text-align: right; padding: 5px 0;">TOTAL:</td>
                                <td style="text-align: right; padding: 5px 0; font-size: 14px;">
                                    <t t-esc="doc.get_receipt_amount_formatted(doc.total_amount)"/>
                                </td>
                            </tr>
                        </table>
                        <div style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed #000;">
                            <table style="width: 100%; font-size: 11px;">
                                <tr>
                                    <td style="width: 50%;">Mode de paiement:</td>
                                    <td style="font-weight: bold;"><t t-esc="doc.get_receipt_payment_label()"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Pied de page -->
                    <div style="text-align: center; margin-top: 20px; padding-top: 10px; border-top: 2px dashed #000; font-size: 10px;">
                        <div style="margin-bottom: 5px;">Merci de votre visite!</div>
                        <div style="font-size: 9px; color: #666;">Ticket genere le <t t-esc="doc.get_receipt_date_formatted()"/></div>
                        <div style="font-size: 9px; color: #666; margin-top: 5px;">Ce ticket est un justificatif de paiement</div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Template aperçu ticket (navigateur, avec accents) -->
    <template id="clinic_receipt_preview_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page container" style="font-family: Arial, sans-serif; font-size: 14px; max-width: 600px; margin: 20px auto; padding: 20px; border: 1px solid #ddd; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    <div style="text-align: center; border-bottom: 2px solid #333; padding-bottom: 15px; margin-bottom: 15px;">
                        <div style="font-size: 22px; font-weight: bold; margin-bottom: 8px;">
                            <t t-esc="doc.env.company.name or 'CLINIQUE'"/>
                        </div>
                        <t t-if="doc.env.company.street">
                            <div style="font-size: 12px;"><t t-esc="doc.env.company.street"/></div>
                        </t>
                        <t t-if="doc.env.company.city">
                            <div style="font-size: 12px;">
                                <t t-esc="doc.env.company.city"/>
                                <t t-if="doc.env.company.zip">, <t t-esc="doc.env.company.zip"/></t>
                            </div>
                        </t>
                        <t t-if="doc.env.company.phone">
                            <div style="font-size: 12px;">Tél: <t t-esc="doc.env.company.phone"/></div>
                        </t>
                        <t t-if="doc.env.company.vat">
                            <div style="font-size: 11px; margin-top: 5px;">NIF: <t t-esc="doc.env.company.vat"/></div>
                        </t>
                    </div>
                    <div style="text-align: center; font-weight: bold; font-size: 18px; margin-bottom: 15px;">TICKET DE CAISSE</div>
                    <table style="width: 100%; font-size: 13px; margin-bottom: 15px;">
                        <tr><td style="width: 35%;">Référence:</td><td style="font-weight: bold;"><t t-esc="doc.name"/></td></tr>
                        <tr><td>Date:</td><td><t t-esc="doc.get_receipt_date_formatted()"/></td></tr>
                        <tr><td>Caissier:</td><td><t t-esc="(doc.cashier_id and doc.cashier_id.name) or doc.env.user.name"/></td></tr>
                    </table>
                    <div style="border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; padding: 12px 0; margin-bottom: 15px;">
                        <div style="font-weight: bold; margin-bottom: 8px;">PATIENT</div>
                        <table style="width: 100%; font-size: 13px;">
                            <tr><td style="width: 35%;">Nom:</td><td><t t-esc="doc.patient_id.name"/></td></tr>
                            <t t-if="doc.patient_id.phone">
                                <tr><td>Téléphone:</td><td><t t-esc="doc.patient_id.phone"/></td></tr>
                            </t>
                            <t t-if="doc.patient_id.ref">
                                <tr><td>N° Dossier:</td><td><t t-esc="doc.patient_id.ref"/></td></tr>
                            </t>
                        </table>
                    </div>
                    <div style="margin-bottom: 15px;">
                        <div style="font-weight: bold; border-bottom: 1px solid #333; padding-bottom: 5px; margin-bottom: 8px;">DÉTAILS DES ACTES</div>
                        <table style="width: 100%; font-size: 12px; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 1px solid #333;">
                                    <th style="text-align: left; padding: 6px 4px;">Acte</th>
                                    <th style="text-align: center; padding: 6px 4px;">Qté</th>
                                    <th style="text-align: right; padding: 6px 4px;">Prix</th>
                                    <th style="text-align: right; padding: 6px 4px;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.visit_line_ids" t-as="line">
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 6px 4px;"><t t-esc="line.product_id.name"/></td>
                                        <td style="text-align: center; padding: 6px 4px;"><t t-esc="int(line.quantity) if line.quantity == int(line.quantity) else '%.2f' % line.quantity"/></td>
                                        <td style="text-align: right; padding: 6px 4px;"><t t-esc="doc.get_receipt_amount_formatted(line.unit_price)"/></td>
                                        <td style="text-align: right; padding: 6px 4px; font-weight: bold;"><t t-esc="doc.get_receipt_amount_formatted(line.subtotal)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div style="border-top: 2px solid #333; padding-top: 12px;">
                        <table style="width: 100%; font-size: 14px; font-weight: bold;">
                            <tr>
                                <td style="text-align: right; padding: 6px 0;">TOTAL:</td>
                                <td style="text-align: right; padding: 6px 0; font-size: 16px;"><t t-esc="doc.get_receipt_amount_formatted(doc.total_amount)"/></td>
                            </tr>
                        </table>
                        <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #ccc; font-size: 13px;">
                            <strong>Mode de paiement:</strong> <t t-esc="doc.get_receipt_payment_label_display()"/>
                        </div>
                    </div>
                    <div style="text-align: center; margin-top: 25px; padding-top: 15px; border-top: 2px solid #333; font-size: 12px; color: #555;">
                        <div style="margin-bottom: 5px;">Merci de votre visite !</div>
                        <div>Ticket généré le <t t-esc="doc.get_receipt_date_formatted()"/></div>
                        <div style="margin-top: 5px;">Ce ticket est un justificatif de paiement.</div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Action PDF: ticket pour imprimante thermique -->
    <record id="action_clinic_receipt_report" model="ir.actions.report">
        <field name="name">Ticket de Caisse</field>
        <field name="model">clinic.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">clinic_patient.clinic_receipt_template</field>
        <field name="report_file">clinic_patient.clinic_receipt_template</field>
        <field name="print_report_name">'Ticket de Caisse - %s' % (object.name)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Action HTML: aperçu ticket dans le navigateur (comme POS) -->
    <record id="action_clinic_receipt_preview" model="ir.actions.report">
        <field name="name">Aperçu Ticket de Caisse</field>
        <field name="model">clinic.visit</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">clinic_patient.clinic_receipt_preview_template</field>
        <field name="report_file">clinic_patient.clinic_receipt_preview_template</field>
        <field name="print_report_name">'Aperçu - %s' % (object.name)</field>
    </record>
</odoo>

