<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Séquence pour les numéros de dossier patient -->
        <record id="seq_clinic_patient" model="ir.sequence">
            <field name="name">Numéro Dossier Patient</field>
            <field name="code">clinic.patient.sequence</field>
            <field name="prefix">PAT/</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- Séquence pour les visites -->
        <record id="seq_clinic_visit" model="ir.sequence">
            <field name="name">Numéro Visite Clinique</field>
            <field name="code">clinic.visit.sequence</field>
            <field name="prefix">VIS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>

