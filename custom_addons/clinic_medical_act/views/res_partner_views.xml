<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extension de la vue formulaire Patient pour ajouter les actes médicaux -->
        <record id="view_clinic_patient_form_medical" model="ir.ui.view">
            <field name="name">clinic.patient.form.medical</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="clinic_patient.view_clinic_patient_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_medical_acts" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-stethoscope"
                            invisible="medical_act_count == 0">
                        <field name="medical_act_count" widget="statinfo" string="Actes"/>
                    </button>
                </div>
                
                <xpath expr="//page[last()]" position="after">
                    <page string="Historique des Actes">
                        <field name="medical_act_ids" readonly="1">
                            <list>
                                <field name="date"/>
                                <field name="product_id"/>
                                <field name="service_type"/>
                                <field name="state" widget="badge" decoration-info="state == 'waiting'" decoration-success="state == 'done'"/>
                                <field name="price_total"/>
                            </list>
                        </field>
                    </page>
                    
                    <page string="Statistiques">
                        <group>
                            <group>
                                <field name="medical_act_count" readonly="1"/>
                                <field name="total_spent" readonly="1"/>
                            </group>
                            <group>
                                <field name="last_visit_date" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        
        <!-- Extension de la vue liste -->
        <record id="view_clinic_patient_list_medical" model="ir.ui.view">
            <field name="name">clinic.patient.list.medical</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="clinic_patient.view_clinic_patient_list"/>
            <field name="arch" type="xml">
                <field name="phone" position="after">
                    <field name="medical_act_count" optional="hide"/>
                    <field name="last_visit_date" optional="hide"/>
                </field>
            </field>
        </record>
        
        <!-- Extension de la vue kanban -->
        <record id="view_clinic_patient_kanban_medical" model="ir.ui.view">
            <field name="name">clinic.patient.kanban.medical</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="clinic_patient.view_clinic_patient_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_kanban_details')]//ul" position="inside">
                    <li><i class="fa fa-stethoscope" title="Actes médicaux"/> <field name="medical_act_count"/> actes</li>
                </xpath>
            </field>
        </record>
        
        <!-- Extension de la vue recherche -->
        <record id="view_clinic_patient_search_medical" model="ir.ui.view">
            <field name="name">clinic.patient.search.medical</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="clinic_patient.view_clinic_patient_search"/>
            <field name="arch" type="xml">
                <field name="phone" position="after">
                    <separator/>
                    <filter string="Visites Récentes" name="recent_visits" 
                            domain="[('last_visit_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                </field>
            </field>
        </record>
    </data>
</odoo>

