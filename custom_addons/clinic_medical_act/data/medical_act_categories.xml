<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégorie principale: Actes Médicaux -->
        <record id="product_category_medical_acts" model="product.category">
            <field name="name">Actes Médicaux</field>
        </record>

        <!-- Sous-catégorie: Consultations -->
        <record id="product_category_consultations" model="product.category">
            <field name="name">Consultations</field>
            <field name="parent_id" ref="product_category_medical_acts"/>
        </record>

        <record id="product_category_consultation_general" model="product.category">
            <field name="name">Consultation Généraliste</field>
            <field name="parent_id" ref="product_category_consultations"/>
        </record>

        <record id="product_category_consultation_specialist" model="product.category">
            <field name="name">Consultation Spécialiste</field>
            <field name="parent_id" ref="product_category_consultations"/>
        </record>

        <!-- Sous-catégorie: Laboratoire -->
        <record id="product_category_laboratory" model="product.category">
            <field name="name">Laboratoire</field>
            <field name="parent_id" ref="product_category_medical_acts"/>
        </record>

        <record id="product_category_lab_hematology" model="product.category">
            <field name="name">Hématologie</field>
            <field name="parent_id" ref="product_category_laboratory"/>
        </record>

        <record id="product_category_lab_biochemistry" model="product.category">
            <field name="name">Biochimie</field>
            <field name="parent_id" ref="product_category_laboratory"/>
        </record>

        <record id="product_category_lab_immunology" model="product.category">
            <field name="name">Immunologie</field>
            <field name="parent_id" ref="product_category_laboratory"/>
        </record>

        <record id="product_category_lab_microbiology" model="product.category">
            <field name="name">Microbiologie</field>
            <field name="parent_id" ref="product_category_laboratory"/>
        </record>

        <!-- Sous-catégorie: Imagerie Médicale -->
        <record id="product_category_imaging" model="product.category">
            <field name="name">Imagerie Médicale</field>
            <field name="parent_id" ref="product_category_medical_acts"/>
        </record>

        <record id="product_category_imaging_radiology" model="product.category">
            <field name="name">Radiologie</field>
            <field name="parent_id" ref="product_category_imaging"/>
        </record>

        <record id="product_category_imaging_ultrasound" model="product.category">
            <field name="name">Échographie</field>
            <field name="parent_id" ref="product_category_imaging"/>
        </record>

        <record id="product_category_imaging_scanner" model="product.category">
            <field name="name">Scanner (CT)</field>
            <field name="parent_id" ref="product_category_imaging"/>
        </record>

        <record id="product_category_imaging_mri" model="product.category">
            <field name="name">IRM</field>
            <field name="parent_id" ref="product_category_imaging"/>
        </record>

        <!-- Séquence pour les actes médicaux -->
        <record id="seq_clinic_medical_act_line" model="ir.sequence">
            <field name="name">Acte Médical</field>
            <field name="code">clinic.medical.act.line</field>
            <field name="prefix">ACT/</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>

